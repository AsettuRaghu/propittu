{
  "name": "@propittu/api",
  "version": "1.0.0",
  "private": true,
  "description": "Propittu API — business layer between the mobile app and Supabase.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "node test/smoke.mjs",
    "test:bundle": "npm run build && SMOKE_TARGET=bundle node test/smoke.mjs",
    "build": "node scripts/build-vercel.mjs",
    "test:ai": "tsx --test test/ai-unit.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.131.0",
    "@propittu/shared": "*",
    "@supabase/supabase-js": "^2.117.2",
    "@vercel/functions": "^3.9.11",
    "express": "^5.2.1",
    "jose": "^6.2.12",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "tsx": "^4.23.15",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/node": "^22.14.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "pino-pretty": "^13.2.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0"
  },
  "engines": {
    "node": ">=22.9.0"
  }
}
