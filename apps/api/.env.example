# Propittu API — copy to apps/api/.env for local development.
# On Vercel these are set as project environment variables (see docs/DEPLOYMENT.md),
# plus CRON_SECRET, which protects the daily /cron/keepalive endpoint.
#
# The API deliberately does NOT need the Supabase secret / service-role key:
# every query and storage call runs as the signed-in user, so RLS applies.

PORT=4000
NODE_ENV=development
LOG_LEVEL=info

# Supabase → Project Settings → API Keys
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# How long signed photo/document view URLs stay valid (seconds).
SIGNED_DOWNLOAD_TTL_SECONDS=3600
