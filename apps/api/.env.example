# Propittu API — copy to apps/api/.env for local development.
# On Vercel these are set as project environment variables (see docs/DEPLOYMENT.md),
# plus CRON_SECRET, which protects the daily /cron/keepalive endpoint.
#
# Every customer and staff query runs as the signed-in user, so RLS applies.
# The Supabase SECRET key is used for exactly one thing: recording payment
# events that were verified (webhook signature / provider status fetch).

PORT=4000
NODE_ENV=development
LOG_LEVEL=info

# Supabase → Project Settings → API Keys
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# How long signed photo/document view URLs stay valid (seconds).
SIGNED_DOWNLOAD_TTL_SECONDS=3600

# ---- Payments (M7) — optional; without them checkout answers 503 ----
# Supabase → Project Settings → API Keys → Secret key (server only, never in the app)
# SUPABASE_SECRET_KEY=sb_secret_xxxxxxxx
# Razorpay Dashboard (Test Mode) → Account & Settings → API Keys
# RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
# RAZORPAY_KEY_SECRET=xxxxxxxx
# Razorpay Dashboard → Webhooks → the secret you set there
# RAZORPAY_WEBHOOK_SECRET=xxxxxxxx
# Public base URL for the payment return page (Vercel sets VERCEL_PROJECT_PRODUCTION_URL)
# PUBLIC_API_URL=http://localhost:4000
