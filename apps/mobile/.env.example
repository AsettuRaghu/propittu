# Propittu mobile app — copy to apps/mobile/.env
#
# EVERYTHING in this file is bundled into the app and is PUBLIC.
# Never put the Supabase secret / service-role key here (PRODUCT_SPEC.md §34).

# The Propittu API.
#   Physical device + local API: use your computer's LAN IP, e.g. http://192.168.1.20:4000
#   (localhost on a phone means the phone itself)
#   Deployed:                    https://propittu-api.onrender.com
EXPO_PUBLIC_API_URL=http://192.168.1.20:4000

# Supabase → Project Settings → API Keys. Used for phone OTP sign-in only;
# all property data goes through the Propittu API.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
