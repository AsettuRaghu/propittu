{
  "name": "propittu",
  "version": "1.0.0",
  "private": true,
  "description": "Propittu — everything about your property, in one place.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "api": "npm run dev --workspace @propittu/api",
    "mobile": "npm run start --workspace @propittu/mobile",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "format": "prettier --write \"**/*.{ts,tsx,json}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,json}\"",
    "test:rls": "bash supabase/rls-check/run.sh",
    "db:push": "supabase db push",
    "db:diff": "supabase db diff"
  },
  "devDependencies": {
    "prettier": "^3.4.2",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "engines": {
    "node": ">=20.19.4"
  }
}
